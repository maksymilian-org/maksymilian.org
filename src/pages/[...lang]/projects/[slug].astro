---
import BaseLayout from "@/src/layouts/BaseLayout.astro";
import { CaseStudyView } from "@/views/CaseStudyView";
import { createTranslator } from "@/lib/i18n";
import { getMessages } from "@/lib/messages";
import { absoluteUrl, buildSeo } from "@/lib/seo";
import { localePathsWith } from "@/lib/routes";
import { caseStudies, pick } from "@/content/projects";
import { site } from "@/content/site";

export function getStaticPaths() {
  return localePathsWith(() => caseStudies.map((p) => ({ params: { slug: p.id }, props: { project: p } })));
}
const { locale, project } = Astro.props;
const n = createTranslator(getMessages(locale), "nav");
const path = `/projects/${project.id}`;
const title = pick(project.title, locale);
const description = pick(project.summary ?? project.description, locale);
const seo = buildSeo({ locale, title: `${title}: case study`, description, path });
const image = project.media?.desktop ?? project.media?.screens?.[0];

const work = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: title,
  description,
  url: absoluteUrl(locale, path),
  inLanguage: locale,
  creator: { "@id": `${site.url}/#person` },
  ...(image ? { image: `${site.url}${image}` } : {}),
  ...(project.technologies ? { keywords: project.technologies } : {}),
};
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: site.brand, item: site.url },
    { "@type": "ListItem", position: 2, name: n("projects"), item: absoluteUrl(locale, "/projects") },
    { "@type": "ListItem", position: 3, name: title },
  ],
};
---

<BaseLayout locale={locale} path={path} seo={seo} jsonLd={[work, breadcrumb]}>
  <CaseStudyView locale={locale} project={project} />
</BaseLayout>
