---
import BaseLayout from "@/src/layouts/BaseLayout.astro";
import { LublinView } from "@/views/LublinView";
import { createTranslator } from "@/lib/i18n";
import { getMessages } from "@/lib/messages";
import { absoluteUrl, buildSeo } from "@/lib/seo";
import { localePaths } from "@/lib/routes";
import { site } from "@/content/site";
import { localBusinessSchema } from "@/components/seo/JsonLd";

export function getStaticPaths() {
  return localePaths();
}
const { locale } = Astro.props;
const messages = getMessages(locale);
const meta = createTranslator(messages, "meta");
const t = createTranslator(messages, "lublin");
const seo = buildSeo({ locale, title: meta("lublin.title"), description: meta("lublin.description"), path: "/lublin" });
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: site.brand, item: site.url },
    { "@type": "ListItem", position: 2, name: t("eyebrow"), item: absoluteUrl(locale, "/lublin") },
  ],
};
---

<BaseLayout locale={locale} path="/lublin" seo={seo} jsonLd={[localBusinessSchema(t("lead")), breadcrumb]}>
  <LublinView locale={locale} />
</BaseLayout>
