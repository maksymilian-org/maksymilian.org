---
import BaseLayout from "@/src/layouts/BaseLayout.astro";
import { ServiceDetailView } from "@/views/ServiceDetailView";
import { createTranslator } from "@/lib/i18n";
import { getMessages } from "@/lib/messages";
import { absoluteUrl, buildSeo } from "@/lib/seo";
import { localePathsWith } from "@/lib/routes";
import { services } from "@/content/services";
import { site } from "@/content/site";

export function getStaticPaths() {
  return localePathsWith(() => services.map((s) => ({ params: { slug: s.slug }, props: { service: s } })));
}
const { locale, service } = Astro.props;
const t = createTranslator(getMessages(locale), "services.items");
const slug = service.slug;
const title = t(`${service.id}.title`);
const description = t(`${service.id}.description`);
const faq = t.raw(`${service.id}.detail.faq`) as { q: string; a: string }[];
const path = `/services/${slug}`;
const seo = buildSeo({ locale, title, description, path });

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: title,
  description,
  serviceType: title,
  provider: { "@type": "Person", name: site.name, url: site.url },
  areaServed: ["PL", "EU"],
  url: absoluteUrl(locale, path),
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: site.brand, item: site.url },
    { "@type": "ListItem", position: 2, name: locale === "pl" ? "Usługi" : "Services", item: absoluteUrl(locale, "/services") },
    { "@type": "ListItem", position: 3, name: title },
  ],
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<BaseLayout locale={locale} path={path} seo={seo} jsonLd={[serviceSchema, breadcrumbSchema, faqSchema]}>
  <ServiceDetailView locale={locale} service={service} />
</BaseLayout>
