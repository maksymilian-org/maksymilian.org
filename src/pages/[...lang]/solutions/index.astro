---
import BaseLayout from "@/src/layouts/BaseLayout.astro";
import { SolutionsView, SOLUTIONS_META } from "@/views/SolutionsView";
import { absoluteUrl, buildSeo } from "@/lib/seo";
import { localePaths } from "@/lib/routes";
import { industries } from "@/content/industries";
import { site } from "@/content/site";

export function getStaticPaths() {
  return localePaths();
}
const { locale } = Astro.props;
const m = SOLUTIONS_META[locale];
const seo = buildSeo({ locale, title: m.title, description: m.description, path: "/solutions" });
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: site.brand, item: site.url },
    { "@type": "ListItem", position: 2, name: m.crumb },
  ],
};
const itemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  itemListElement: industries.map((i, n) => ({
    "@type": "ListItem",
    position: n + 1,
    name: i.title[locale],
    url: absoluteUrl(locale, `/solutions/${i.slug}`),
  })),
};
---

<BaseLayout locale={locale} path="/solutions" seo={seo} jsonLd={[breadcrumb, itemList]}>
  <SolutionsView locale={locale} />
</BaseLayout>
