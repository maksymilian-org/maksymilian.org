---
import BaseLayout from "@/src/layouts/BaseLayout.astro";
import { buildSeo } from "@/lib/seo";

const locale = "en";
const seo = { ...buildSeo({ locale, title: "Page not found", description: "This page does not exist.", path: "/" }), noindex: true };
---

<BaseLayout locale={locale} path="/" seo={seo}>
  <section class="py-24">
    <div class="container-page text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-brand">404</p>
      <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">Page not found</h1>
      <p class="mx-auto mt-4 max-w-md text-muted">The page you are looking for does not exist or has moved.</p>
      <p class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/" class="rounded-xl bg-brand-solid px-5 py-3 text-sm font-semibold text-white">Home</a>
        <a href="/pl" class="rounded-xl border border-border px-5 py-3 text-sm font-semibold">Polski</a>
      </p>
    </div>
  </section>
</BaseLayout>
